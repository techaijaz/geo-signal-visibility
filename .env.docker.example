# Docker Compose environment — copy to .env next to docker-compose.yml and fill in.
# Variables marked REQUIRED stop `docker compose up` if missing.

# Database (REQUIRED) — MongoDB Atlas or any reachable MongoDB
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/geo-db?retryWrites=true&w=majority

# Redis password (REQUIRED) — Redis is only reachable inside the Docker network
REDIS_PASSWORD=change_me_long_random_string

# Auth secrets (REQUIRED) — long random strings, different from each other
ACCESS_TOKEN_SECRET=change_me_access_secret
REFRESH_TOKEN_SECRET=change_me_refresh_secret

# URLs
SERVER_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Signal AI" <no-reply@your-domain.com>

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# AI provider keys (can also be set encrypted from Admin → API Keys)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=
