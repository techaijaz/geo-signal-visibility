# Production environment for docker-compose.yml. Copy to .env next to docker-compose.yml.
# Generate secrets with:  openssl rand -hex 32
# Use letters and digits only for MONGO_PASSWORD and REDIS_PASSWORD (they go into URLs).

# Your domain (without www). The site runs on DOMAIN, the app and API on app.DOMAIN
DOMAIN=geosignalai.com
LETSENCRYPT_EMAIL=you@geosignalai.com

# Server mode. Leave these commented on a server of its own (Docker nginx takes ports 80/443).
# On a server that already runs another site through its own nginx (shared server), uncomment:
# NGINX_HTTP_BIND=127.0.0.1:8088
# NGINX_HTTPS_BIND=127.0.0.1:8443
# NGINX_TEMPLATES=./nginx/templates-behind-proxy

# MongoDB cache in GB. 1 on a server of its own; 0.5 when sharing an 8 GB server; 0.25 on 4 GB
MONGO_CACHE_GB=1

# Memory caps per container (defaults suit an 8 GB server). On a 4 GB server shared with another site:
# MONGO_MEM_LIMIT=768m
# API_MEM_LIMIT=512m
# WORKER_MEM_LIMIT=1g
# and fewer parallel jobs (1 CPU):
# SCAN_WORKER_CONCURRENCY=2
# AUDIT_WORKER_CONCURRENCY=1
# RECOMMENDATION_WORKER_CONCURRENCY=1
# AI_PROVIDER_CONCURRENCY=4

# MongoDB (runs in Docker on this server)
MONGO_USER=signal
MONGO_PASSWORD=change_me_hex_string
MONGO_DB=signal

# Redis
REDIS_PASSWORD=change_me_hex_string

# Auth secrets: two different long random strings.
# Never change ACCESS_TOKEN_SECRET after launch: it also encrypts the AI keys saved in Admin > API Keys.
ACCESS_TOKEN_SECRET=change_me_access_secret
REFRESH_TOKEN_SECRET=change_me_refresh_secret

# Requests per visitor IP per minute across the API
RATE_LIMIT_PER_MINUTE=120

# Email: EMAIL_PROVIDER=smtp uses the SMTP_* settings below (Hostinger mail);
# EMAIL_PROVIDER=resend uses RESEND_API_KEY (verify your domain in Resend first)
EMAIL_PROVIDER=smtp
EMAIL_FROM="Signal AI" <no-reply@your-domain.com>
RESEND_API_KEY=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@your-domain.com
SMTP_PASS=
SMTP_FROM="Signal AI" <no-reply@your-domain.com>

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# AI provider keys (can also be set encrypted from Admin > API Keys)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=
