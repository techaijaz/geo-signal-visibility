---
import { plans, engines, inr, links, company } from '../config/site'
const engineName = (id: string) => engines.find((e) => e.id === id)!
const perMonth = (p: (typeof plans)[number], cycle: 'monthly' | 'yearly') =>
  p.monthly === null ? null : cycle === 'monthly' ? p.monthly : Math.round((p.yearly ?? 0) / 12)
---
<div class="pricing" data-pricing>
  <div class="cycle" role="radiogroup" aria-label="Billing cycle">
    <button type="button" role="radio" aria-checked="true" data-cycle="monthly">Monthly</button>
    <button type="button" role="radio" aria-checked="false" data-cycle="yearly">Yearly <span>2 months free</span></button>
    <span class="cycle-thumb" aria-hidden="true"></span>
  </div>

  <div class="plans">
    {plans.map((p) => {
      const m = perMonth(p, 'monthly')
      const y = perMonth(p, 'yearly')
      return (
        <article class:list={['plan', { featured: p.featured }]}>
          <header>
            <h3>{p.name}</h3>
            {p.featured && <p class="pick">Most founders start here</p>}
            <p class="pitch">{p.pitch}</p>
          </header>
          <p class="price">
            {m === null ? (
              <span class="amount">Custom</span>
            ) : (
              <>
                <span class="amount num" data-monthly={m} data-yearly={y}>{inr(m)}</span>
                {m > 0 && <span class="per">/month</span>}
              </>
            )}
          </p>
          <p class="billed" data-billed-monthly={m ? 'Billed monthly, GST included' : m === 0 ? 'Free forever' : 'Priced for your client list'} data-billed-yearly={p.yearly ? `${inr(p.yearly)} billed yearly, GST included` : m === 0 ? 'Free forever' : 'Priced for your client list'}>
            {m ? 'Billed monthly, GST included' : m === 0 ? 'Free forever' : 'Priced for your client list'}
          </p>
          <a class:list={['btn', p.featured ? 'btn--marker' : 'btn--ghost']} href={p.id === 'agency' ? `mailto:${company.salesEmail}?subject=Signal%20AI%20Agency%20plan` : links.signup}>{p.cta}</a>
          <ul class="facts">
            <li><b>{p.brands}</b></li>
            <li>{p.queries}</li>
            <li>{p.scans}</li>
            <li>{p.manual}</li>
          </ul>
          <div class="engines" aria-label={`AI engines: ${p.engines.map((e) => engineName(e).name).join(', ')}`}>
            {p.engines.map((e) => (
              <span class="eng"><span class="engine-dot" style={`background:${engineName(e).color}`}></span>{engineName(e).name}</span>
            ))}
          </div>
          <ul class="extras">
            {p.extras.map((x) => <li>{x}</li>)}
          </ul>
        </article>
      )
    })}
  </div>
</div>

<style>
  .pricing { display: grid; gap: 32px; }
  .cycle { position: relative; display: inline-grid; grid-template-columns: 1fr 1fr; justify-self: start; padding: 4px; border: 1px solid var(--rule); border-radius: 999px; background: var(--sheet); }
  .cycle button { position: relative; z-index: 1; font: 600 var(--t-sm)/1 var(--font); color: var(--slate); background: none; border: 0; padding: 11px 18px; cursor: pointer; border-radius: 999px; white-space: nowrap; transition: color .2s; }
  .cycle button[aria-checked='true'] { color: var(--porcelain); }
  .cycle button span { font-weight: 500; opacity: .8; margin-left: 4px; }
  .cycle-thumb { position: absolute; top: 4px; bottom: 4px; left: 4px; width: calc(50% - 4px); border-radius: 999px; background: var(--ink); transition: transform .3s var(--ease-out); }
  .pricing[data-cycle='yearly'] .cycle-thumb { transform: translateX(100%); }

  /* Subgrid lines up price, button and lists across every plan whatever the text length */
  .plans { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 0; row-gap: 18px; border: 1px solid var(--rule); border-radius: var(--r-sheet); background: var(--sheet); overflow: hidden; }
  .plan { display: grid; grid-row: span 7; grid-template-rows: subgrid; padding: 28px 24px; border-left: 1px solid var(--rule-soft); }
  .plan:first-child { border-left: 0; }
  .plan.featured { background: #FFFBEF; box-shadow: inset 0 4px 0 var(--marker); }
  header { display: grid; gap: 6px; }
  h3 { font-size: var(--t-lg); }
  .pick { font-size: var(--t-sm); font-weight: 600; color: var(--marker-deep); }
  .pitch { color: var(--slate); font-size: var(--t-sm); line-height: 1.5; }
  .price { display: flex; align-items: baseline; gap: 4px; }
  .amount { font-size: var(--t-xl); font-weight: 800; letter-spacing: -0.03em; font-variation-settings: 'wdth' 85; }
  .per { color: var(--slate); }
  .billed { font-size: var(--t-sm); color: var(--slate); margin-top: -12px; }
  .plan .btn { width: 100%; align-self: start; }
  .extras { align-content: start; }
  .facts, .extras { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; font-size: var(--t-sm); }
  .facts { padding-top: 18px; border-top: 1px solid var(--rule-soft); }
  .extras li { padding-left: 20px; position: relative; color: var(--slate); }
  .extras li::before { content: '✓'; position: absolute; left: 0; color: var(--found); font-weight: 800; }
  .engines { display: flex; flex-wrap: wrap; align-self: start; align-content: start; gap: 6px 12px; font-size: var(--t-sm); }
  .eng { display: inline-flex; align-items: center; gap: 5px; }

  @media (max-width: 1060px) {
    .plans { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .plan:nth-child(3) { border-left: 0; }
    .plan:nth-child(n + 3) { border-top: 1px solid var(--rule-soft); }
  }
  @media (max-width: 620px) {
    .plans { grid-template-columns: 1fr; }
    .plan { border-left: 0; }
    .plan + .plan { border-top: 1px solid var(--rule-soft); }
  }
</style>

<script>
  const fmt = (n: number) => '₹' + Math.round(n).toLocaleString('en-IN')
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  document.querySelectorAll<HTMLElement>('[data-pricing]').forEach((root) => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-cycle]')]
    const amounts = [...root.querySelectorAll<HTMLElement>('[data-monthly]')]
    const billed = [...root.querySelectorAll<HTMLElement>('[data-billed-monthly]')]
    const setCycle = (cycle: 'monthly' | 'yearly') => {
      root.dataset.cycle = cycle
      buttons.forEach((b) => b.setAttribute('aria-checked', String(b.dataset.cycle === cycle)))
      billed.forEach((b) => (b.textContent = cycle === 'monthly' ? b.dataset.billedMonthly! : b.dataset.billedYearly!))
      amounts.forEach((el) => {
        const from = Number(el.dataset.shown ?? el.dataset.monthly)
        const to = Number(cycle === 'monthly' ? el.dataset.monthly : el.dataset.yearly)
        el.dataset.shown = String(to)
        if (reduce || from === to) { el.textContent = fmt(to); return }
        const start = performance.now()
        const tick = (t: number) => {
          const k = Math.min(1, (t - start) / 450)
          const e = 1 - Math.pow(1 - k, 3)
          el.textContent = fmt(from + (to - from) * e)
          if (k < 1) requestAnimationFrame(tick)
        }
        requestAnimationFrame(tick)
      })
    }
    buttons.forEach((b) => b.addEventListener('click', () => setCycle(b.dataset.cycle as 'monthly' | 'yearly')))
  })
</script>
