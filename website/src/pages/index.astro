---
import Base from '../layouts/Base.astro'
import AnswerTheatre from '../components/AnswerTheatre.astro'
import FeatureTabs from '../components/FeatureTabs.astro'
import CompareTable from '../components/CompareTable.astro'
import PricingPlans from '../components/PricingPlans.astro'
import Faq from '../components/Faq.astro'
import CtaBand from '../components/CtaBand.astro'

const steps = [
  { title: 'Add your store and the questions that matter', body: 'Enter your website and category. We suggest the questions your buyers ask, in English and Hinglish, and you can add your own.' },
  { title: 'We ask the AIs for you', body: 'Signal AI puts each question to ChatGPT, Gemini, Claude, Grok and DeepSeek on your plan’s schedule and reads every answer.' },
  { title: 'See where you stand', body: 'For each question and each AI: were you mentioned, at what position, in what tone, and which competitors were named instead.' },
  { title: 'Fix what holds you back', body: 'Unblock AI crawlers, add the right schema, and follow ranked recommendations. Then watch the next scans move.' }
]

const faqs = [
  { q: 'What is GEO?', a: 'Generative engine optimisation (GEO) is making sure AI assistants like ChatGPT and Gemini know your brand and recommend it when someone asks for a product like yours. It is to AI answers what SEO is to Google results.' },
  { q: 'Do I need a Shopify store?', a: 'No. We lead with Shopify because most of our customers use it, but Signal AI works for any website: WooCommerce, Magento, a custom store or a D2C brand that sells on marketplaces.' },
  { q: 'How is this different from SEO tools?', a: 'SEO tools track where you rank in Google’s list of links. AI assistants don’t show a list; they write an answer and name a few brands. Signal AI reads those answers and tells you whether you are one of the brands named.' },
  { q: 'Can I track questions in Hinglish?', a: 'Yes. Questions are plain text, so you can track them exactly the way your customers type them, including Hinglish like “sabse accha face wash kaunsa hai”.' },
  { q: 'Is there a free plan?', a: 'Yes. The Free plan tracks 3 questions for 1 brand on ChatGPT, Gemini and Claude every week, with no card needed. Upgrade when you want daily scans and more questions.' }
]
---
<Base title="Signal AI" description="See where your brand shows up when shoppers ask ChatGPT, Gemini, Claude, Grok and DeepSeek what to buy. Built for Shopify and D2C brands in India. Free plan available.">
  <AnswerTheatre />

  <section class="band band--sheet shift">
    <div class="wrap shift-grid">
      <div class="shift-copy">
        <h2>A search page shows ten links. An AI answer names three brands and stops.</h2>
        <p>Shoppers now ask ChatGPT and Gemini which product to buy, and many go with what the answer says. If your brand is not in those few lines, the shopper never sees it, however good your Google ranking is.</p>
        <p>Signal AI shows you those lines, for your questions, every day.</p>
      </div>
      <div class="shift-visual" aria-hidden="true">
        <div class="serp">
          <p class="vis-label">Search results</p>
          {Array.from({ length: 10 }).map((_, i) => <span class="serp-row" style={`--w:${60 + ((i * 37) % 35)}%`}></span>)}
        </div>
        <div class="ai">
          <p class="vis-label">AI answer</p>
          <span class="ai-line" style="--w:92%"></span>
          <span class="ai-pick"><b>1.</b><span style="--w:70%"></span></span>
          <span class="ai-pick you"><b>2.</b><span class="mark on">Your brand</span></span>
          <span class="ai-pick"><b>3.</b><span style="--w:58%"></span></span>
        </div>
      </div>
    </div>
  </section>

  <section class="band" id="how">
    <div class="wrap">
      <div class="section-head">
        <h2>How Signal AI works</h2>
        <p>Set up once in about five minutes. After that, scans run on their own.</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="step-n">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band band--sheet">
    <div class="wrap">
      <div class="section-head">
        <h2>Everything you need to get named by AI</h2>
        <p>Tracking tells you where you stand. The audit and recommendations tell you what to change.</p>
      </div>
      <FeatureTabs />
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="section-head">
        <h2>More AIs for less, billed in rupees</h2>
        <p>Most AI visibility tools are priced in dollars for US teams. Signal AI tracks five AIs from ₹2,999 a month and bills in INR with UPI.</p>
      </div>
      <CompareTable tier="entry" />
      <p class="more"><a href="/compare">See the full comparison</a></p>
    </div>
  </section>

  <section class="band band--sheet">
    <div class="wrap">
      <div class="section-head">
        <h2>Pricing</h2>
        <p>Start free. Upgrade when you want daily scans, more questions and more AIs.</p>
      </div>
      <PricingPlans />
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="section-head"><h2>Questions founders ask</h2></div>
      <Faq items={faqs} />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .shift-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 88px); align-items: center; }
  .shift-copy { display: grid; gap: 18px; }
  .shift-copy h2 { max-width: 20ch; }
  .shift-copy p { color: var(--slate); max-width: 52ch; }
  .shift-copy p:last-child { color: var(--ink); font-weight: 600; }
  .shift-visual { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; align-items: start; }
  .serp, .ai { border: 1px solid var(--rule); border-radius: var(--r-sheet); padding: 18px; display: grid; gap: 9px; background: var(--porcelain); }
  .ai { background: var(--sheet); border-color: var(--ink); gap: 14px; padding: 22px 18px; }
  .vis-label { font-size: var(--t-sm); color: var(--slate); margin-bottom: 4px; }
  .serp-row { height: 8px; width: var(--w); background: var(--rule); border-radius: 4px; }
  .ai-line { height: 8px; width: var(--w); background: var(--rule); border-radius: 4px; }
  .ai-pick { display: flex; align-items: center; gap: 8px; font-size: var(--t-sm); }
  .ai-pick > span:not(.mark) { height: 10px; width: var(--w); background: #B9C6C4; border-radius: 4px; }
  .ai-pick.you { font-weight: 700; }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; counter-reset: s; }
  .steps li { display: grid; gap: 12px; align-content: start; padding: 0 24px 0 0; margin-right: 24px; border-right: 1px solid var(--rule); }
  .steps li:last-child { border-right: 0; margin-right: 0; }
  .step-n { font-size: var(--t-2xl); font-weight: 800; line-height: 1; color: var(--marker-deep); font-variation-settings: 'wdth' 75; }
  .steps p { color: var(--slate); }

  .more { margin-top: 20px; }
  .more a { font-weight: 600; text-decoration-color: var(--marker); text-decoration-thickness: 2px; text-underline-offset: 5px; }

  @media (max-width: 900px) {
    .shift-grid { grid-template-columns: 1fr; }
    .steps { grid-template-columns: 1fr 1fr; row-gap: 36px; }
    .steps li:nth-child(2) { border-right: 0; margin-right: 0; }
  }
  @media (max-width: 560px) {
    .steps { grid-template-columns: 1fr; }
    .steps li { border-right: 0; margin-right: 0; padding: 0; }
    .shift-visual { grid-template-columns: 1fr 1fr; gap: 12px; }
  }
</style>
