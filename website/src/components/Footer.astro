---
import Logo from './Logo.astro'
import { company, legalNav, links } from '../config/site'
const year = new Date().getFullYear()
---
<footer class="site-footer">
  <div class="wrap">
    <div class="top">
      <div class="brand">
        <Logo tone="light" />
        <p>See where your brand shows up when shoppers ask ChatGPT, Gemini, Claude, Grok and DeepSeek what to buy.</p>
        <a class="btn btn--marker" href={links.signup}>Start free</a>
      </div>
      <nav aria-label="Product">
        <h2>Product</h2>
        <ul>
          <li><a href="/features">Features</a></li>
          <li><a href="/compare">Compare</a></li>
          <li><a href="/pricing">Pricing</a></li>
          <li><a href={links.login}>Log in</a></li>
        </ul>
      </nav>
      <nav aria-label="Company">
        <h2>Company</h2>
        <ul>
          <li><a href="/about">About us</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/contact">Contact us</a></li>
        </ul>
      </nav>
      <nav aria-label="Legal">
        <h2>Policies</h2>
        <ul>
          {legalNav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    </div>
    <div class="base">
      <p>© {year} {company.legalName}. All rights reserved.</p>
      <p>{company.address}</p>
      <p>GSTIN {company.gstin}</p>
      <p><a href={`mailto:${company.email}`}>{company.email}</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink); color: #B7C8CA; padding: 72px 0 40px; }
  .top { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: 40px; padding-bottom: 48px; border-bottom: 1px solid #25444A; }
  .brand { display: grid; gap: 18px; align-content: start; max-width: 340px; }
  .brand p { line-height: 1.55; }
  .brand .btn { justify-self: start; color: var(--ink); }
  h2 { font-size: var(--t-base); color: var(--porcelain); letter-spacing: 0; font-variation-settings: 'wdth' 100; margin-bottom: 14px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  a { color: #B7C8CA; text-decoration: none; }
  nav a:hover, .base a:hover { color: var(--marker); }
  .base { display: flex; flex-wrap: wrap; gap: 8px 28px; padding-top: 28px; font-size: var(--t-sm); color: #7F9799; }
  .base a { color: #7F9799; }
  @media (max-width: 820px) {
    .top { grid-template-columns: 1fr 1fr; }
    .brand { grid-column: 1 / -1; }
  }
</style>
