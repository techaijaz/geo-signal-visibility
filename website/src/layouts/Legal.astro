---
import Base from './Base.astro'
import { legalNav } from '../config/site'

interface Props { title: string; description: string; updated: string }
const { title, description, updated } = Astro.props
const path = Astro.url.pathname.replace(/\/$/, '')
---
<Base title={title} description={description}>
  <section class="band">
    <div class="wrap layout">
      <nav class="side" aria-label="Policies">
        <p class="side-title">Policies</p>
        <ul>
          {legalNav.map((l) => <li><a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a></li>)}
        </ul>
      </nav>
      <article>
        <header>
          <h1>{title}</h1>
          <p class="updated">Last updated <time datetime={updated}>{new Date(updated).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' })}</time></p>
        </header>
        <div class="legal">
          <slot />
        </div>
      </article>
    </div>
  </section>
</Base>

<style>
  .layout { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: clamp(32px, 6vw, 80px); align-items: start; }
  .side { position: sticky; top: 96px; }
  .side-title { font-weight: 700; margin-bottom: 10px; }
  .side ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .side a { display: block; padding: 8px 0 8px 14px; border-left: 2px solid var(--rule); color: var(--slate); text-decoration: none; }
  .side a:hover { color: var(--ink); }
  .side a[aria-current='page'] { color: var(--ink); font-weight: 600; border-left-color: var(--marker); }
  header { display: grid; gap: 10px; margin-bottom: 32px; }
  h1 { font-size: var(--t-2xl); }
  .updated { color: var(--slate); }
  .legal { max-width: 72ch; }
  .legal :global(h2) { font-size: var(--t-md); letter-spacing: -0.01em; font-variation-settings: 'wdth' 95; margin: 2em 0 .6em; }
  .legal :global(p), .legal :global(ul) { margin: 0 0 1em; }
  .legal :global(ul) { padding-left: 1.3em; }
  .legal :global(li) { margin-bottom: .4em; }
  .legal :global(a) { text-decoration-color: var(--marker); text-decoration-thickness: 2px; text-underline-offset: 3px; }
  @media (max-width: 820px) {
    .layout { grid-template-columns: 1fr; }
    .side { position: static; }
  }
</style>
