# ===========================================
# SIGNAL - GEO AI Visibility SaaS
# Backend Environment Configuration
# ===========================================

# Node Environment
NODE_ENV=development

# Server
PORT=5000
SERVER_URL=http://localhost:5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# ===========================================
# Database - MongoDB
# ===========================================
# Local: mongodb://localhost:27017/geo-signal
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/geo-signal
DATABASE_URL=mongodb://localhost:27017/geo-signal

# ===========================================
# JWT Secrets
# ===========================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# ===========================================
# SMTP / Email Configuration
# ===========================================
EMAIL_SERVICE_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
# Gmail App Password (not your regular password)
# https://myaccount.google.com/apppasswords
SMTP_PASS=your_app_password_here
SMTP_FROM="Signal AI" <your_email@gmail.com>

# ===========================================
# AI Provider API Keys
# ===========================================
# Get keys from:
# - DeepSeek: https://platform.deepseek.com/
# - OpenAI: https://platform.openai.com/
# - Gemini: https://ai.google.dev/
# - Anthropic: https://console.anthropic.com/
# - OmniRoute: https://omniroute.ai/

# DeepSeek (sasta — recommended for main scans)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_NAME=deepseek-chat

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini

# Google Gemini (free tier available)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash

# Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL_NAME=claude-3-5-sonnet-20241022

# OmniRoute Unified Router
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL_NAME=omniroute-auto
OMNIROUTE_BASE_URL=https://api.omniroute.ai/v1/chat/completions

# ===========================================
# Redis (for job queue) — Coming in Step 3
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379