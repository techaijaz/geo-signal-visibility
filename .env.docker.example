# Docker Environment Variables Example (.env)
NODE_ENV=production
PORT=8080

# Database & Redis
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/geo-db?retryWrites=true&w=majority
REDIS_HOST=redis
REDIS_PORT=6379

# Auth & Secrets
JWT_SECRET=your_super_secret_jwt_key_change_me
FRONTEND_URL=http://your-domain.com

# LLM API Keys
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIzaSy...
ANTHROPIC_API_KEY=sk-ant-...
