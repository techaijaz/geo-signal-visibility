---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } }))
}
---
<div class="faq">
  {items.map((i) => (
    <details>
      <summary><span>{i.q}</span><span class="sign" aria-hidden="true"></span></summary>
      <div class="body"><div><p>{i.a}</p></div></div>
    </details>
  ))}
</div>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<style>
  .faq { border-top: 1px solid var(--rule); max-width: 820px; }
  details { border-bottom: 1px solid var(--rule); }
  summary { list-style: none; display: flex; justify-content: space-between; gap: 24px; align-items: center; padding: 20px 0; cursor: pointer; font-weight: 600; font-size: var(--t-md); line-height: 1.35; }
  summary::-webkit-details-marker { display: none; }
  .sign { position: relative; width: 16px; height: 16px; flex: none; }
  .sign::before, .sign::after { content: ''; position: absolute; left: 0; top: 7px; width: 16px; height: 2px; background: var(--ink); border-radius: 2px; transition: transform .25s var(--ease-out); }
  .sign::after { transform: rotate(90deg); }
  details[open] .sign::after { transform: rotate(0deg); }
  .body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .3s var(--ease-out); }
  details[open] .body { grid-template-rows: 1fr; }
  .body > div { overflow: hidden; }
  .body p { padding-bottom: 22px; color: var(--slate); max-width: 68ch; }
</style>

<script>
  // Animate closing too: keep <details> open until the collapse finishes
  document.querySelectorAll<HTMLDetailsElement>('.faq details').forEach((d) => {
    const summary = d.querySelector('summary')!
    const body = d.querySelector<HTMLElement>('.body')!
    summary.addEventListener('click', (e) => {
      if (!d.open) return
      e.preventDefault()
      body.style.gridTemplateRows = '0fr'
      body.addEventListener('transitionend', () => { d.open = false; body.style.gridTemplateRows = '' }, { once: true })
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { d.open = false; body.style.gridTemplateRows = '' }
    })
  })
</script>
