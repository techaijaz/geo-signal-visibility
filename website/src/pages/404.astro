---
import Base from '../layouts/Base.astro'
---
<Base title="Page not found" description="This page does not exist.">
  <section class="band">
    <div class="wrap nf">
      <h1>This page isn’t in any answer</h1>
      <p class="lede">The link may be old or mistyped. Try the homepage or pricing instead.</p>
      <div class="actions">
        <a class="btn btn--marker" href="/">Go to homepage</a>
        <a class="btn btn--ghost" href="/pricing">See pricing</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { display: grid; gap: 24px; min-height: 50vh; align-content: center; }
  .nf h1 { font-size: var(--t-2xl); max-width: 16ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
