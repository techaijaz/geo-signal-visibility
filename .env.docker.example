# Production environment for docker-compose.yml. Copy to .env next to docker-compose.yml.
# Generate secrets with:  openssl rand -hex 32
# Use letters and digits only for MONGO_PASSWORD and REDIS_PASSWORD (they go into URLs).

# Your domain (without www). The site runs on DOMAIN, the app and API on app.DOMAIN
DOMAIN=your-domain.com
LETSENCRYPT_EMAIL=you@your-domain.com

# MongoDB (runs in Docker on this server)
MONGO_USER=signal
MONGO_PASSWORD=change_me_hex_string
MONGO_DB=signal

# Redis
REDIS_PASSWORD=change_me_hex_string

# Auth secrets: two different long random strings.
# Never change ACCESS_TOKEN_SECRET after launch: it also encrypts the AI keys saved in Admin > API Keys.
ACCESS_TOKEN_SECRET=change_me_access_secret
REFRESH_TOKEN_SECRET=change_me_refresh_secret

# Requests per visitor IP per minute across the API
RATE_LIMIT_PER_MINUTE=120

# Email: EMAIL_PROVIDER=smtp uses the SMTP_* settings below (Hostinger mail);
# EMAIL_PROVIDER=resend uses RESEND_API_KEY (verify your domain in Resend first)
EMAIL_PROVIDER=smtp
EMAIL_FROM="Signal AI" <no-reply@your-domain.com>
RESEND_API_KEY=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@your-domain.com
SMTP_PASS=
SMTP_FROM="Signal AI" <no-reply@your-domain.com>

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# AI provider keys (can also be set encrypted from Admin > API Keys)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=
